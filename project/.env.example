# Separate true/false switches for UP orderbooks and Chainlink + TWAP.
# Explicit switches take precedence over legacy POLY_SYMBOLS/SPOT_SYMBOLS.
BTC_ORDERBOOK_ENABLED=true
BTC_SPOT_ENABLED=true
ETH_ORDERBOOK_ENABLED=true
ETH_SPOT_ENABLED=true
SOL_ORDERBOOK_ENABLED=true
SOL_SPOT_ENABLED=true
XRP_ORDERBOOK_ENABLED=true
XRP_SPOT_ENABLED=true

# New v2 collectors: UP only, 15-minute markets.
POLY_TIMEFRAMES=15m
POLY_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLY_GAMMA_URL=https://gamma-api.polymarket.com/markets
POLY_PREFETCH_SEC=45
POLY_CLOSE_GRACE_SEC=10

# Ordinary Chainlink and TWAP 30/60s are subscribed together.
SPOT_WS_URL=wss://ws-live-data.polymarket.com

# Existing ClickHouse database. v2 tables are created automatically.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=polyk
CLICKHOUSE_HTTP_INTERFACE=http
CLICKHOUSE_TIMEOUT_SEC=10
CH_INSERT_RETRIES=3
CH_INSERT_RETRY_BACKOFF_SEC=0.5
CH_HTTP_COMPRESSION=true

# Print row counts after each confirmed database insert, without market values.
COLLECTOR_LOG_ENABLED=true

# Optional: separate state directory and table prefix for isolated tests.
# COLLECTOR_STATE_DIR=/absolute/path/to/state
# COLLECTOR_TABLE_PREFIX=test_
# COLLECTOR_RUN_SECONDS=60
